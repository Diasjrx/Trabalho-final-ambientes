{
  "name": "taskflow",
  "version": "1.0.0",
  "description": "Aplicação fullstack com HTML, CSS, JS, ExpressJS e testes Cypress",
  "scripts": {
    "start:backend": "cd backend && node index.js",
    "install:backend": "cd backend && npm install",
    "install:all": "npm install && cd backend && npm install",
    "test:frontend": "cypress run --spec 'cypress/e2e/frontend.cy.js'",
    "test:backend": "cypress run --spec 'cypress/e2e/backend.cy.js'",
    "test:all": "cypress run",
    "cypress:open": "cypress open"
  },
  "devDependencies": {
    "cypress": "^13.6.3"
  }
}
